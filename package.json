{
  "name": "foundry-desktop-pilot",
  "version": "1.0.2",
  "private": true,
  "description": "Foundry proper desktop shell pilot",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac:x64": "electron-builder --mac zip dmg --x64",
    "dist:mac:arm64": "electron-builder --mac zip dmg --arm64",
    "dist:win": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "nz.foundry.desktop",
    "productName": "Foundry",
    "asar": true,
    "files": ["app/**/*"],
    "directories": {"output": "dist"},
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [{"target":"zip","arch":["x64","arm64"]},{"target":"dmg","arch":["x64","arm64"]}],
      "minimumSystemVersion": "10.15.0",
      "identity": "-"
    },
    "dmg": {"title": "Foundry ${version}"},
    "win": {"target": ["nsis","zip"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
